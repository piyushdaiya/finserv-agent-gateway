{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grant/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grant_id",
    "workflow_id",
    "tenant_id",
    "allowed_actions",
    "resource_scope",
    "issued_by",
    "issued_at",
    "expires_at",
    "status",
    "grant_sha256",
    "authority_context",
    "allowed_purposes",
    "allowed_destinations",
    "data_scope",
    "authority_bounds"
  ],
  "properties": {
    "schema_version": {
      "const": "grant/v1"
    },
    "grant_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "workflow_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "allowed_actions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 256,
      "items": {
        "type": "string"
      }
    },
    "resource_scope": {
      "type": "object"
    },
    "issued_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "REVOKED",
        "EXPIRED"
      ]
    },
    "grant_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "requesting_principal",
        "acting_actor",
        "authority_source",
        "delegation_chain"
      ],
      "properties": {
        "schema_version": {
          "const": "authority-context/v1"
        },
        "requesting_principal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principal_id",
            "principal_type"
          ],
          "properties": {
            "principal_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "principal_type": {
              "enum": [
                "HUMAN",
                "SERVICE",
                "BUSINESS_PROCESS"
              ]
            }
          }
        },
        "acting_actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_id",
            "actor_type"
          ],
          "properties": {
            "actor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "actor_type": {
              "enum": [
                "AGENT",
                "SERVICE",
                "AUTOMATION"
              ]
            }
          }
        },
        "authority_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "delegation_chain": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "delegator_id",
              "delegate_id",
              "scope_sha256",
              "issued_at",
              "expires_at"
            ],
            "properties": {
              "delegator_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "delegate_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "scope_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "issued_at": {
                "type": "string",
                "format": "date-time"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "allowed_purposes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
      }
    },
    "allowed_destinations": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "enum": [
          "HUMAN_REVIEW_UI",
          "INTERNAL_SERVICE",
          "INTERNAL_AGENT_RUNTIME",
          "LOCAL_MODEL",
          "APPROVED_EXTERNAL_MODEL",
          "EXTERNAL_SERVICE"
        ]
      }
    },
    "data_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_sensitivity",
        "allowed_fields",
        "denied_fields",
        "allowed_categories",
        "max_records_per_action",
        "max_bytes_per_action",
        "bulk_access"
      ],
      "properties": {
        "maximum_sensitivity": {
          "enum": [
            "D0_PUBLIC",
            "D1_INTERNAL",
            "D2_CUSTOMER_CONFIDENTIAL",
            "D3_RESTRICTED"
          ]
        },
        "allowed_fields": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1024,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "denied_fields": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1024,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "allowed_categories": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 256,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
          }
        },
        "max_records_per_action": {
          "type": "integer",
          "minimum": 0
        },
        "max_bytes_per_action": {
          "type": "integer",
          "minimum": 0
        },
        "bulk_access": {
          "type": "boolean"
        }
      }
    },
    "authority_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_action_count",
        "max_total_records",
        "max_total_bytes",
        "max_delegation_depth",
        "max_fan_out",
        "numeric_limits"
      ],
      "properties": {
        "max_action_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_total_records": {
          "type": "integer",
          "minimum": 0
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_delegation_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "max_fan_out": {
          "type": "integer",
          "minimum": 0
        },
        "numeric_limits": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
