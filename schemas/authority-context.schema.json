{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "authority-context/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "requesting_principal",
    "acting_actor",
    "authority_source",
    "delegation_chain"
  ],
  "properties": {
    "schema_version": {
      "const": "authority-context/v1"
    },
    "requesting_principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "principal_type"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "principal_type": {
          "enum": [
            "HUMAN",
            "SERVICE",
            "BUSINESS_PROCESS"
          ]
        }
      }
    },
    "acting_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_type"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actor_type": {
          "enum": [
            "AGENT",
            "SERVICE",
            "AUTOMATION"
          ]
        }
      }
    },
    "authority_source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "delegation_chain": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "delegator_id",
          "delegate_id",
          "scope_sha256",
          "issued_at",
          "expires_at"
        ],
        "properties": {
          "delegator_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "delegate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "scope_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
