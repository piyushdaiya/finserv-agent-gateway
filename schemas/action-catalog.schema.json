{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action-catalog/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "pack_version",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": "action-catalog/v1"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
    },
    "pack_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "impact_class",
          "mutating",
          "adapter",
          "payload_schema_id",
          "result_schema_id",
          "redaction_profile"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+(?:\\.[a-z0-9_-]+)+$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "impact_class": {
            "enum": [
              "I0_METADATA",
              "I1_SENSITIVE_READ",
              "I2_REVERSIBLE_WRITE",
              "I3_HIGH_IMPACT"
            ]
          },
          "mutating": {
            "type": "boolean"
          },
          "adapter": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
          },
          "payload_schema_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "result_schema_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "fact_extractor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "redaction_profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "idempotency_required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
