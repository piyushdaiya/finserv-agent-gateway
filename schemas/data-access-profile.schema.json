{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data-access-profile/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "maximum_sensitivity",
    "source_projection",
    "bulk_access",
    "field_rules"
  ],
  "properties": {
    "schema_version": {
      "const": "data-access-profile/v1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "maximum_sensitivity": {
      "enum": [
        "D0_PUBLIC",
        "D1_INTERNAL",
        "D2_CUSTOMER_CONFIDENTIAL",
        "D3_RESTRICTED"
      ]
    },
    "source_projection": {
      "enum": [
        "REQUIRED",
        "PREFERRED",
        "UNAVAILABLE",
        "NOT_APPLICABLE"
      ]
    },
    "bulk_access": {
      "enum": [
        "DENY_BY_DEFAULT",
        "EXPLICIT_ONLY",
        "NOT_APPLICABLE"
      ]
    },
    "default_max_records": {
      "type": "integer",
      "minimum": 0
    },
    "default_max_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "allowed_purposes": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 128,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
      }
    },
    "allowed_destinations": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "enum": [
          "HUMAN_REVIEW_UI",
          "INTERNAL_SERVICE",
          "INTERNAL_AGENT_RUNTIME",
          "LOCAL_MODEL",
          "APPROVED_EXTERNAL_MODEL",
          "EXTERNAL_SERVICE"
        ]
      }
    },
    "field_rules": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "category",
          "sensitivity",
          "disclosure"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "category": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
          },
          "sensitivity": {
            "enum": [
              "D0_PUBLIC",
              "D1_INTERNAL",
              "D2_CUSTOMER_CONFIDENTIAL",
              "D3_RESTRICTED"
            ]
          },
          "disclosure": {
            "enum": [
              "ALLOW",
              "DENY",
              "MASK",
              "TOKENIZE"
            ]
          }
        }
      }
    }
  }
}
