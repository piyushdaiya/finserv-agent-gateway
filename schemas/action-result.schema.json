{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "status",
    "decision",
    "reason_code",
    "correlation_id"
  ],
  "properties": {
    "schema_version": {
      "const": "action-result/v1"
    },
    "action_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DENIED",
        "PENDING_APPROVAL",
        "COMPLETED",
        "FAILED",
        "OUTCOME_UNKNOWN"
      ]
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_APPROVAL"
      ]
    },
    "reason_code": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "approval_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
