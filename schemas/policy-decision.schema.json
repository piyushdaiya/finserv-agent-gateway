{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy-decision/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "action_id",
    "effect",
    "reason_code",
    "policy_id",
    "policy_version",
    "policy_sha256",
    "decision_input_sha256",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "policy-decision/v1"
    },
    "decision_id": {
      "type": "string"
    },
    "action_id": {
      "type": "string"
    },
    "effect": {
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_APPROVAL"
      ]
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    },
    "policy_id": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
