{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "policy/v1"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "priority",
          "effect",
          "reason_code"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
          },
          "priority": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z0-9_*.-]{1,128}$"
          },
          "impact_classes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "I0_METADATA",
                "I1_READ",
                "I2_REVERSIBLE_WRITE",
                "I3_HIGH_IMPACT"
              ]
            }
          },
          "predicates": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "key",
                "operator"
              ],
              "properties": {
                "source": {
                  "enum": [
                    "data",
                    "authority",
                    "principal",
                    "actor",
                    "workflow",
                    "grant",
                    "action",
                    "facts",
                    "approval"
                  ]
                },
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
                },
                "operator": {
                  "enum": [
                    "EQ",
                    "NEQ",
                    "IN",
                    "NOT_IN",
                    "PRESENT",
                    "ABSENT",
                    "INT_GTE",
                    "INT_LTE",
                    "CONTAINS"
                  ]
                },
                "value": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                }
              }
            }
          },
          "effect": {
            "enum": [
              "ALLOW",
              "DENY",
              "REQUIRE_APPROVAL"
            ]
          },
          "reason_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
          },
          "data_sensitivities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "D0_PUBLIC",
                "D1_INTERNAL",
                "D2_CUSTOMER_CONFIDENTIAL",
                "D3_RESTRICTED"
              ]
            }
          }
        }
      }
    }
  }
}
