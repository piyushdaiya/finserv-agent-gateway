{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-bundle-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "workflow_id",
    "tenant_id",
    "generated_at",
    "files",
    "audit_event_sha256s",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "evidence-bundle-manifest/v1"
    },
    "bundle_id": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "redaction_profile": {
      "type": "string"
    },
    "audit_event_sha256s": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
