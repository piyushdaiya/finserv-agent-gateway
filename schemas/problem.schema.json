{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "code",
    "title",
    "correlation_id"
  ],
  "properties": {
    "schema_version": {
      "const": "problem/v1"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "detail": {
      "type": "string",
      "maxLength": 2048
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
